# Resend API key (resend.com → API Keys). Required for the contact form to send email.
RESEND_API_KEY=

# Where survey requests are delivered.
NOTIFY_EMAIL=carew@ccms-survey.com

# Sender address. Must be on a domain verified in Resend.
# Before verification you can test with: CCMS Website <onboarding@resend.dev>
FROM_EMAIL=CCMS Website <requests@ccms-survey.com>

# Optional backup: Google Apps Script web app URL (see scripts/google-apps-script.gs).
SHEETS_WEBHOOK_URL=

# ---- Staff CRM (/admin) ----

# Signs staff login cookies. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Staff accounts as a JSON array. Make each entry with:
#   node scripts/staff-user.mjs "Full Name" username "password"
STAFF_USERS=[]

# Lead storage. Vercel injects this when a PRIVATE Blob store is connected to
# the project (Storage → Create → Blob → Private). Leave empty locally and
# leads are kept in .crm-data/ instead.
BLOB_READ_WRITE_TOKEN=
